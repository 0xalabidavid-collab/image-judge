# No key needed for the Claude Code option: set IMAGE_JUDGE_MODEL=claude-code:opus (uses your
# logged-in `claude` CLI). Otherwise set ONE of these keys.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# For Anthropic-compatible gateways, use the origin only; the SDK adds /v1/messages.
# ANTHROPIC_BASE_URL=https://api.example.com
# Optional overrides
# IMAGE_JUDGE_MODEL=claude-code:opus         # or a gateway model such as claude-opus-5
# IMAGE_JUDGE_RUNS=4
# IMAGE_JUDGE_RUBRIC=v1
# IMAGE_JUDGE_EFFORT=high                    # Gemini: low/medium/high thinking level
# IMAGE_JUDGE_MAX_CONCURRENCY=4              # lower this on the Gemini free tier
# IMAGE_JUDGE_FALLBACKS=0                  # recommended for third-party Anthropic-compatible gateways
# IMAGE_JUDGE_API_TIMEOUT=105              # hard wall-clock limit per parallel judge pass
