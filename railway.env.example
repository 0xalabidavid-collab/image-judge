# Variables for Railway (service > Variables > Raw Editor: paste these lines).
# Replace every <...> with your real value. Keep real secrets OUT of this file and out of git:
# edit a private copy, paste it into Railway, then delete the copy.

IMAGE_JUDGE_AUTH=1
IMAGE_JUDGE_ADMIN_EMAILS=<your-email>
IMAGE_JUDGE_DATABASE_URL=<supabase session-pooler address, with your DB password filled in>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase anon / publishable key>
S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=<r2 access key id>
S3_SECRET_ACCESS_KEY=<r2 secret access key>
S3_BUCKET=image-judge
S3_REGION=auto
ANTHROPIC_API_KEY=<your NEW mwapi key>
ANTHROPIC_BASE_URL=https://api.mwapi.dev
IMAGE_JUDGE_MODEL=claude-sonnet-5
IMAGE_JUDGE_RUBRIC=v3
IMAGE_JUDGE_RUNS=2
IMAGE_JUDGE_FALLBACKS=0
IMAGE_JUDGE_MAX_CONCURRENCY=2
